# T1 template — /etc/katmate/vm/app_sandbox.toml (ADR-015, ADR-030, ADR-032 §1, §3)
#
# NOT a T1 file. The installer creates /etc/katmate/vm/app_sandbox.toml from this,
# root:root 0644, and never overwrites a file it did not create in the same run
# (ADR-032: the installer seeds T1; the file is the user's from then on).
# Values are the alpha's frozen parameters, docs/PARAMETERS.md (operator rulings
# of 2026-10-06; planned, not yet read back on MINIS). tools/make-release.sh
# validates these templates with tools/validate-properties.fish --strict at
# release time.
#
# The sandbox: software from outside KatMate, installed from user space only
# into the persistent home (tarballs, extracted AppImages, static binaries).
# Root stays locked and there is no sudo, as in every AppVM. It runs on the web
# layer; identity = false, because it is where untrusted software runs (ruling
# of 2026-10-06).
class = "app"
cid = 25
manifest = "web"
netvm = "netvm"
persistence = "persistent"
identity = false
disposable = false
mem = "2G"
vcpus = 2
