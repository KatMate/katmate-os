#!/usr/bin/env bash
# gen-desktop-entries — the launcher's desktop entries, one per (AppVM, app),
# and one that opens the AppVM list
#
# Usage: gen-desktop-entries <t1-vm-dir> <t2-dir> <outdir>
#
# The instances are the T1 files with class = app, in name order: the set
# katmate-launch admits. What each may run is the RUN line of its layer's T2 meta, the list
# katmate-launch enforces (ADR-043 §5): each instance's T1 file names the
# layer, and <t2-dir>/app-<layer>.meta carries RUN. km-menu shows <outdir> to
# fuzzel as the only applications directory, and reads X-KatMate-Instance for
# its AppVM list.
#
# Exit: 0 written, 1 refused (the message says why), 2 usage.

set -euo pipefail

die() { printf '[gen-desktop-entries] FATAL: %s\n' "$*" >&2; exit 1; }

(( $# == 3 )) || { echo "usage: gen-desktop-entries <t1-vm-dir> <t2-dir> <outdir>" >&2; exit 2; }
T1_DIR="$1"
T2_DIR="$2"
OUT="$3"
export LC_COLLATE=C

LIB="$(dirname -- "$0")/../host/usr/lib/katmate/katmate-lib.sh"
[[ -r "$LIB" ]] || die "$LIB is not readable"
# shellcheck disable=SC2034
KM_PROG="gen-desktop-entries"
# shellcheck source=host/usr/lib/katmate/katmate-lib.sh
source "$LIB"

# Prints "<instance> <app>" lines, in instance name order and RUN order.
read_apps() {
    local f line inst layer meta app n=0
    local -a run=()
    local -A t1=()
    for f in "$T1_DIR"/*.toml; do
        [[ -e "$f" ]] || continue
        inst="${f##*/}"
        inst="${inst%.toml}"
        km_flat_read "$f" t1
        [[ "${t1[class]-}" == app ]] || continue
        layer="${t1[manifest]-}"
        [[ "$layer" =~ $KM_LAYER_NAME_RE ]] \
            || die "$T1_DIR/$inst.toml: manifest='$layer' does not match $KM_LAYER_NAME_RE"
        meta="$T2_DIR/app-$layer.meta"
        km_meta_open "$meta"
        # read_apps runs in $(…), where set -e does not hold: exit explicitly.
        line="$(km_meta_require "$meta" RUN)" || exit 1
        read -r -a run <<<"$line"
        for app in "${run[@]}"; do
            [[ "$app" =~ $KM_PKG_NAME_RE ]] || die "$meta: RUN entry '$app' does not match $KM_PKG_NAME_RE"
            printf '%s %s\n' "$inst" "$app"
        done
        n=$(( n + 1 ))
    done
    (( n > 0 )) || die "$T1_DIR holds no T1 file with class = app"
}

# Cosmetic only: the RUN list is the authority, so a binary without a display
# name is shown by its own name (cu2 ruling D9).
label() {
    case "$1" in
        firefox-esr) echo Firefox ;;
        foot)        echo Terminal ;;
        pcmanfm)     echo Files ;;
        libreoffice) echo LibreOffice ;;
        keepassxc)   echo KeePassXC ;;
        *)           echo "$1" ;;
    esac
}

if [[ -e "$OUT" ]]; then
    [[ -d "$OUT" && -z "$(ls -A "$OUT")" ]] || die "$OUT exists and is not an empty directory"
fi
# Read in full before the first file, so a refusal leaves no partial set.
pairs="$(read_apps)"
install -d -m 0755 "$OUT"

# The file name's index keeps the instance order for km-menu's list.
declare -A idx=()
count=0
while read -r inst app; do
    [[ "$inst" == app_* ]] || die "instance '$inst' does not begin with app_"
    [[ -v idx[$inst] ]] || idx[$inst]=$(printf '%02d' "${#idx[@]}")
    name="$(label "$app")"
    f="$OUT/km-${idx[$inst]}-$inst-$app.desktop"
    printf '%s\n' \
        '[Desktop Entry]' \
        'Type=Application' \
        "Name=[${inst#app_}] $name" \
        "Exec=/usr/local/bin/km-launch $inst $app" \
        'Terminal=false' \
        "X-KatMate-Instance=$inst" >"$f"
    chmod 0644 "$f"
    count=$(( count + 1 ))
done <<<"$pairs"

# The AppVM list (state, stop) is reached from the launcher, not from the bar.
f="$OUT/km-99-appvms.desktop"
printf '%s\n' \
    '[Desktop Entry]' \
    'Type=Application' \
    'Name=KatMate: AppVMs' \
    'Exec=/usr/local/bin/km-menu vms' \
    'Terminal=false' >"$f"
chmod 0644 "$f"

echo "[gen-desktop-entries] $count entries for ${#idx[@]} instances, and the AppVMs entry, in $OUT"
