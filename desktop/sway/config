# ---------------------------------------------------------------
# KatMate OS — Sway
# Port of CYBRland (scherrer-txt, GPL-3.0) from Hyprland
# Portable: no hardcoded $HOME, no hardcoded output names.
# Source of values: vars.conf, theme.conf, hyprland.conf
# ---------------------------------------------------------------

### VARIABLES ####################################################

    set $mod  Mod4
    set $alt  Mod1

    set $left  h
    set $down  j
    set $up    k
    set $right l

    # The host terminal. Applications run in AppVMs and are launched from
    # the waybar KatMate menu (custom/katmate); the host binds no application
    # but this one (operator rulings 2026-10-05: rule 4, D3).
    set $term        foot

    # Waybar, from the system paths the installer deploys (desktop/README.md;
    # operator ruling 2026-10-05, D8). Hyprland's own config is untouched.
    set $bar waybar -c /etc/xdg/waybar/config-sway.jsonc \
                    -s /etc/xdg/waybar/style-sway.css


# Black-Screen-Wallpaper-3-1.jpg
# 8544377.jpg

### PALETTE (vars.conf) ##########################################

    set $no0 #030408
    set $no1 #05070D
    set $no2 #0A0E1A
    set $re0 #2DD4BF
    set $re1 #0F766E
    set $re2 #042F2E
    set $gr0 #30F291
    set $ye0 #F2D230
    set $cy0 #29BECC
    set $or0 #F26118
    set $wh0 #898D99


### DECORATION ###################################################

    font pango:GeistMono Nerd Font 12

    # theme.conf: $border = 1 · $gapS = 4 · $gapM = 8
    default_border          pixel 1
    default_floating_border pixel 1
    gaps inner 4
    gaps outer 8
    smart_gaps  off
    smart_borders off

    # client.<state> <border> <background> <text> <indicator> <child_border>
    #
    # Hyprland had col.inactive_border = rgba($cy0 00) — alpha 00, i.e. the
    # inactive border is INVISIBLE. Sway's client colours are documented as
    # #RRGGBB. Approximated here with $no0 (near black) so unfocused windows
    # read as borderless against the wallpaper.
    #   VERIFY: if sway 1.12 accepts #RRGGBBAA, try  #29BECC00  for an exact
    #   match and report back.
    client.focused          $re0 $no1 $re0 $re0 $re0
    client.focused_inactive $no0 $no1 $wh0 $no0 $no0
    client.unfocused        $no0 $no1 $wh0 $no0 $no0
    client.urgent           $ye0 $ye0 $no0 $ye0 $ye0
    client.background       $no0

    # Marks are host-set via IPC and unspoofable by a guest — the candidate
    # carrier for the domain indicator. NOTE: with `border pixel` there is no
    # titlebar, so marks are not drawn. To test them, switch temporarily to:
    #   default_border normal 1
    show_marks yes


### OUTPUT #######################################################

# No output block by design — names differ per machine and a name that
    # does not match is silently ignored, which is worse than no block.
    # Sway's default lays outputs out horizontally in discovery order.
    # Per-machine geometry belongs in an installer-generated file.

    # Wallpaper: desktop/wallpapers/default.jpg, installed as a system file
    # (desktop/README.md). The trailing $no0 is sway's fallback_color: if the
    # file cannot be accessed, sway uses it as a solid colour, which is the
    # previous `output * bg $no0 solid_color`, and logs at debug level only.
    output * bg /usr/share/backgrounds/katmate/default.jpg fill $no0

    include outputs.conf

### INPUT ########################################################

    # The layout is not this file's to choose (operator ruling 2026-10-05,
    # rule 5). "us" is only the default for a machine whose installer wrote
    # nothing. The installer writes the machine's layout to
    # /etc/sway/config.d/10-keyboard.conf, which the `include` at the end of
    # this file reads after this block; a later `input` block for the same
    # identifier is merged over this one, so it replaces xkb_layout and
    # leaves the rest. The file contract is in desktop/README.md.
    input type:keyboard {
        xkb_layout  "us"
        xkb_options "compose:rctrl,lv3:ralt_switch,grp:alt_space_toggle"
        xkb_numlock enabled
    }
    #   NOTE: grp:alt_space_toggle switches between layouts; it does something
    #   only when 10-keyboard.conf names more than one (xkb_layout "si,us").

    input type:touchpad {
        natural_scroll enabled
        dwt            enabled
        tap            enabled
    }

    focus_follows_mouse yes
    floating_modifier $mod normal


### KEYBINDINGS — APPLICATIONS ###################################

    bindsym $mod+Return    exec $term


### KEYBINDINGS — LAUNCHERS ######################################

    # No rofi (operator ruling 2026-10-05, rule 1 and D2): applications come
    # from the waybar KatMate menu, power actions from the menu on custom/arch.

    bindsym $mod+n       exec swaync-client -t -sw
    bindsym $mod+Shift+r exec swaync-client -R && swaync-client -rs

    bindsym $mod+Ctrl+r  exec killall waybar; $bar
    bindsym $mod+Ctrl+t  exec killall -SIGUSR1 waybar


### KEYBINDINGS — WINDOWS ########################################

    bindsym $mod+q       kill
    bindsym $mod+a       floating toggle
    bindsym $mod+f       fullscreen toggle
    bindsym $mod+c       move position center

    # Focus
    bindsym $mod+$left   focus left
    bindsym $mod+$down   focus down
    bindsym $mod+$up     focus up
    bindsym $mod+$right  focus right
    bindsym $mod+Left    focus left
    bindsym $mod+Down    focus down
    bindsym $mod+Up      focus up
    bindsym $mod+Right   focus right

    # Move
    bindsym $mod+Shift+$left   move left
    bindsym $mod+Shift+$down   move down
    bindsym $mod+Shift+$up     move up
    bindsym $mod+Shift+$right  move right
    bindsym $mod+Shift+Left    move left
    bindsym $mod+Shift+Down    move down
    bindsym $mod+Shift+Up      move up
    bindsym $mod+Shift+Right   move right

    # Layout
    bindsym $mod+Shift+s layout toggle split
    bindsym $mod+g       layout toggle tabbed stacking split
    bindsym $alt+Tab     focus next sibling
    #   NOTE: $mod+g and $alt+Tab approximate Hyprland's togglegroup /
    #   changegroupactive. Sway has no window groups; tabbed containers are
    #   the nearest concept.  VERIFY that `focus next sibling` parses.

	bindsym $mod+Shift+q exec swaymsg exit

    # Resize (Hyprland submap "resize", 40px steps)
    mode "resize" {
        bindsym $right resize grow   width  40px
        bindsym $left  resize shrink width  40px
        bindsym $up    resize shrink height 40px
        bindsym $down  resize grow   height 40px
        bindsym Right  resize grow   width  40px
        bindsym Left   resize shrink width  40px
        bindsym Up     resize shrink height 40px
        bindsym Down   resize grow   height 40px
        bindsym Escape mode "default"
        bindsym Return mode "default"
    }
    bindsym $mod+r mode "resize"

    # Scratchpad (native — pyprland dropped)
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus       scratchpad show


### KEYBINDINGS — WORKSPACES #####################################

    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9

    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9

    bindsym $mod+Ctrl+Left  workspace prev_on_output
    bindsym $mod+Ctrl+Right workspace next_on_output
    bindsym $mod+Ctrl+$left  workspace prev_on_output
    bindsym $mod+Ctrl+$right workspace next_on_output

    bindsym --whole-window $mod+button4 workspace prev_on_output
    bindsym --whole-window $mod+button5 workspace next_on_output


### KEYBINDINGS — SCREENSHOT & MEDIA #############################

    bindsym $mod+Print   exec grim -g "$(slurp)" - | wl-copy
    bindsym Shift+Escape exec /usr/local/bin/km-shot

    bindsym --locked XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    bindsym --locked XF86AudioPlay        exec playerctl play-pause
    bindsym --locked XF86AudioPause       exec playerctl play-pause
    bindsym --locked XF86AudioNext        exec playerctl next
    bindsym --locked XF86AudioPrev        exec playerctl previous

    bindsym --locked XF86MonBrightnessUp   exec brightnessctl s +5%
    bindsym --locked XF86MonBrightnessDown exec brightnessctl s 5%-



### WINDOW RULES #################################################

    # Only rules for windows KatMate shows. Every rule for an application
    # KatMate does not ship is gone (operator ruling 2026-10-05, rule 2 and
    # D4): app launchers, settings panels, monitor scratchpads, polkit agents,
    # media players, game clients.

    # An AppVM window's title starts with its "[<instance>] " label (vm-agent,
    # waypipe --title-prefix), so the dialog names may follow one. The label
    # is guest-set and cosmetic; this rule only floats a dialog.
    for_window [title="^(\[[A-Za-z0-9_-]+\] )?(Open Folder|Open File|Save File|Save Folder|Delete File|Confirm File Delete|Save Image|Save As|Open As).*$"] \
        floating enable, resize set width 50 ppt height 50 ppt, move position center


### DOMAIN INDICATOR — placeholder ###############################
#
#   Reserved. The indicator is driven from OUTSIDE this file, by a host-side
#   process subscribed to sway IPC. Three unspoofable channels, all keyed on
#   PID (host knows it — it spawned the waypipe client):
#
#     border width   for_window [pid=N] border pixel <1|2|4>
#     mark           swaymsg [pid=N] mark <domain>      (needs a titlebar)
#     focused colour swaymsg client.focused '<c> <c> <c> <c> <c>'
#
#   client.focused is global, but only the focused window has a visible
#   border (see DECORATION above), so one global value is sufficient.
#
#   Nothing here yet. ADR-016 revision decides the carrier set.


### AUTOSTART ####################################################
# (from ~/.config/hypr/scripts/services — hypr* replaced)

    exec dbus-update-activation-environment --systemd \
         WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP

    exec $bar
    exec swaync
    #   Removed (operator ruling 2026-10-05, rule 2): cliphist, the
    #   polkit-gnome agent, udiskie, swayosd-server, easyeffects. polkitd
    #   itself is a system service and stays: logind needs it for the power
    #   menu's poweroff, reboot and suspend.

    # hypridle → swayidle. Left commented: hypridle.conf was not supplied, so
    # the timeouts are unknown and an unexpected lock mid-test is unwelcome.
    # exec swayidle -w \
    #      timeout 900 'swaylock -f' \
    #      before-sleep 'swaylock -f'

    # exec_always for anything that must survive `swaymsg reload`.

# Machine-local configuration written by the installer, the keyboard layout
# among it (10-keyboard.conf, desktop/README.md). The distribution's sway
# package may put its own files here too. Last, so it overrides the above.
include /etc/sway/config.d/*
