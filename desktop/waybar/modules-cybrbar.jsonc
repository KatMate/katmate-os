/*
# ---------------------------------------
# CYBRbar     waybar modules — KatMate sway bar
# Based on CYBRland's modules.jsonc (scherrer-txt, GPL-3.0,
# https://github.com/scherrer-txt/cybrland), pruned for KatMate.
#
# Only the modules config-sway.jsonc names are kept (operator ruling
# 2026-10-05, rule 3). Dropped: every hyprland/* module, music, notifications,
# updates, recorder, tray, GPU and temperature modules, the unused arrows,
# and custom/brightness, whose exec and scroll scripts were absolute paths
# into another user's home that the tree does not carry.
#
# A module here may display; it does not launch an application KatMate does
# not ship (ruling D4). The click handlers that opened btop, nvtop,
# blueman-manager, nm-connection-editor and pavucontrol in a kitty scratchpad
# are gone; pulseaudio keeps wpctl, which only changes the host's mixer.
# custom/arch opens the power menu, power-menu.xml (rule 1), in place of the
# rofi powermenu; its right-click rofi launcher is gone, not replaced.
# Its Arch glyph is replaced by the KatMate mark (operator ruling 2026-10-09,
# 1): the format is three spaces, so waybar keeps the module, and the mark is
# drawn as a background image by style-sway.css.
# ---------------------------------------
*/
{
	/* ARROWS */
	"custom/arrow-right-no1": {
		"format": "  ",
		"tooltip": false
	},
	/* BATTERY */
	"battery": {
		"format": "{capacity}% {icon}",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{time} {icon}",
		"format-icons": [
			"󰂎",
			"󰁺",
			"󰁻",
			"󰁼",
			"󰁽",
			"󰁾",
			"󰁿",
			"󰂀",
			"󰂁",
			"󰂂",
			"󰁹"
		],
		"tooltip": false,
		"interval": 5,
		"states": {
			"warning": 30,
			"critical": 10
		}
	},
	/* BLUETOOTH */
	"bluetooth": {
		"format": "",
		"format-disabled": "",
		"format-connected": " {num_connections}",
		"format-connected-battery": "{icon} {num_connections}",
		"format-icons": [
			"󰥇",
			"󰤾",
			"󰤿",
			"󰥀",
			"󰥁",
			"󰥂",
			"󰥃",
			"󰥄",
			"󰥅",
			"󰥆",
			"󰥈"
		],
		"tooltip-format": "{controller_alias}\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\t{icon} {device_battery_percentage}%"
	},
	/* CLOCKS */
	"clock#time": {
		"format": "{:%H.%M:%OS}",
		"interval": 1,
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "left",
			"on-scroll": 1,
			"on-click-right": "mode"
		}
	},
	"clock#date": {
		"format": "{:%Y/%m/%d}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "left",
			"on-scroll": 1,
			"on-click-right": "mode"
		}
	},
	/* CPU USAGE */
	"cpu": {
		"format": "   {usage}%",
		"tooltip-format": "CPU",
		"interval": 2
	},
	/* RAM USAGE */
	"memory": {
		"format": "   {}%",
		"tooltip-format": "RAM",
		"interval": 2
	},
	/* NETWORK */
	"network": {
		"format-wifi": "   {signalStrength}%",
		"format-ethernet": "   LAN",
		"tooltip-format-wifi": "Network: <b>{essid}</b>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\n<span foreground='#eed49f'> {bandwidthDownBytes}</span> <span foreground='#b7bdf8'> {bandwidthUpBytes}</span>",
		"tooltip-format-ethernet": "Network: <b>{essid}</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\n<span foreground='#eed49f'> {bandwidthDownBytes}</span> <span foreground='#b7bdf8'> {bandwidthUpBytes}</span>",
		"format-linked": "󰈀   {ifname}",
		"format-disconnected": "󰖪   OFF",
		"tooltip": true,
		"interval": 2
	},
	/* AUDIO */
	"pulseaudio": {
		"format": "   {volume}%",
		"format-muted": "   MUTE",
		"interval": 1,
		"tooltip-format": "{desc}, {volume}%",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
	},
	/* LOGO */
	"custom/arch": {
		"format": "   ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "/usr/share/katmate/waybar/power-menu.xml",
		"menu-actions": {
			"poweroff": "systemctl poweroff",
			"reboot":   "systemctl reboot",
			"suspend":  "systemctl suspend",
			"exit":     "swaymsg exit"
		}
	}
}
