/*
# ---------------------------------------
# KatMate launcher button
# Left click (and $mod+d in sway/config): fuzzel over the generated
# (AppVM, app) entries in /usr/share/katmate/applications/, each of which
# runs km-launch, which runs katmate-launch through sudo (R151; SECURITY-MODEL
# gap 17) and turns a non-zero exit into a critical desktop notification
# (operator ruling 2, 2026-10-04). Right click: the AppVMs with their state,
# to stop one or all. Both are desktop/bin/km-menu.
# The full record is in the journal: journalctl -t katmate-launch
# ---------------------------------------
*/
{
	"custom/katmate": {
		"format": "KatMate",
		"tooltip": false,
		"on-click": "/usr/local/bin/km-menu apps",
		"on-click-right": "/usr/local/bin/km-menu vms"
	}
}
