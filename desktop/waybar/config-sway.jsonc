/*
# ---------------------------------------
# CYBRbar     waybar config — SWAY session
# Based on CYBRland (GPL-3.0), modified for KatMate/Sway
# Parallel to config.jsonc (Hyprland). Neither touches the other.
# Launch: waybar -c /etc/xdg/waybar/config-sway.jsonc \
#                -s /etc/xdg/waybar/style-sway.css
# System paths, deployed by the installer (desktop/README.md; D8).
# ---------------------------------------
*/
[
	{
		"include": [
			"/etc/xdg/waybar/modules-cybrbar.jsonc",
			"/etc/xdg/waybar/modules-sway.jsonc",
			"/etc/xdg/waybar/modules-katmate.jsonc"
		],
		"height": 31,
		"layer": "top",
		"mode": "dock",
		"exclusive": true,
		"passthrough": false,
		"gtk-layer-shell": true,
		"margin-top": 0,
		"margin-left": 0,
		"margin-bottom": 0,
		"margin-right": 0,
		"on-scroll-threshold": 1,

		"modules-left": [
			"custom/katmate",
			"custom/arch",
			"sway/workspaces",
			"custom/cut-left-end"
		],

		"modules-center": [
			"custom/cut-center-start",
			"clock#date",
			"sway/window",
			"clock#time",
			"custom/cut-center-end"
		],

		"modules-right": [
			"custom/arrow-right-no1",
			"memory",
			"cpu",
			"network",
			"battery",
			"bluetooth",
			"pulseaudio",
			"custom/cut-right-end"
		]
	}
]
