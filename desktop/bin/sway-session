#!/usr/bin/env bash
# ---------------------------------------------------------------
# KatMate OS — sway session wrapper
# Based on CYBRland (GPL-3.0), modified for KatMate/Sway
# Installed as /usr/local/bin/sway-session (chmod +x); greetd's session
# entry runs it through /usr/local/bin/sway-quiet.
#
# Sway's config has no `env =` directive — unlike hyprland.conf,
# which set these inline. They must be exported before sway starts,
# so this wrapper is not optional.
#
# Values carried over verbatim from hyprland.conf § ENV, except the Qt
# theme pair (QT_QPA_PLATFORMTHEME=qt6ct, QT_STYLE_OVERRIDE=kvantum):
# neither qt6ct nor kvantum is installed on a KatMate host, and the host
# runs no Qt application (operator ruling R14, 2026-10-05).
# ---------------------------------------------------------------

# XDG
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=sway

# Qt
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1

# GTK
export GTK_THEME=Adwaita-dark

# Firefox on Wayland (hyprland.conf relied on XDG_SESSION_TYPE alone;
# explicit here because it is cheap and removes one variable)
export MOZ_ENABLE_WAYLAND=1

exec sway "$@"
