#!/usr/bin/env bash
# katmate-launch — start an alpha AppVM and run one application in it
#
# T4 (ADR-032 §2), shipped at /usr/lib/katmate/katmate-launch. It is the
# launch daemon's alpha precursor (ADR-029's note of 2026-10-03; R150): it does
# by script, at one click, what alpha integration steps 1–5 did by hand at
# every start. It is not the launch daemon. It orders units and parents
# nothing (ADR-029): systemd starts QEMU, and this script only writes the
# owner, issues NETCFG, starts and stops units, and speaks to the agents.
#
# Usage:
#   katmate-launch <instance> <app>     start <instance> unless its unit is
#                                       active, wait for PING, then RUN <app>
#   katmate-launch --stop <instance>    SHUTDOWN, wait for the unit to leave
#                                       active, then (routed) NETCFG REMOVE
#                                       and remove the owner
#   katmate-launch --stop-all           --stop for every AppVM in T1 that is
#                                       running or still holds a link
#   katmate-launch --cid-check          #58's CID uniqueness over the T1 tree,
#                                       which every launch also runs
#
# Exit status, katmate-lib.sh's convention and not a new one:
#   0  done
#   1  refused, or an action failed: the message says which, and so does the
#      journal (tag katmate-launch)
#   2  called wrongly: usage
#
# Privilege: it runs as uid 0 and refuses otherwise. The desktop user reaches it
# through one sudoers rule, NOPASSWD for exactly this path (R151), which is a
# dev/alpha shortcut that the launch daemon replaces (SECURITY-MODEL gap 17).
# So everything it takes from the caller is checked before it is used: the
# instance name by km_check_instance and by its T1 file, and the app name
# against the RUN line of the instance's layer meta (ADR-043 §5).
#
# The menu starts it with no terminal, through desktop/bin/km-launch, which on a
# non-zero exit shows the last FATAL line (else the last stderr line) as a
# critical desktop notification. Everything else goes nowhere a person reads,
# so every action is also one journal line:
#   journalctl -t katmate-launch

set -euo pipefail
umask 022
# sudo's secure_path is the caller's configuration, not this script's. Every
# program below is a system binary, and ping-client is called by its absolute
# path (R155).
export PATH=/usr/bin

# The uid guard comes first, before anything is read: it must not depend on the
# library being where it should be, and nothing this script reads or writes is
# meant for any other uid (R151).
if (( EUID != 0 )); then
    printf '[katmate-launch] FATAL: must run as uid 0 (sudo -n /usr/lib/katmate/katmate-launch …, R151): it writes owners under /run/katmate and starts system units\n' >&2
    logger -t katmate-launch -- "FATAL: refused, uid $EUID is not 0" || true
    exit 1
fi

# KM_PROG is the diagnostic prefix; it is read by katmate-lib.sh after the
# source below, which shellcheck cannot see across an absolute path.
# shellcheck disable=SC2034
KM_PROG="katmate-launch"
# shellcheck source=host/usr/lib/katmate/katmate-lib.sh
source /usr/lib/katmate/katmate-lib.sh

# The control client, installed beside this script as a T4 binary (R155). Never
# a build tree: this runs as root, and a binary uid 1000 can replace would make
# the sudoers rule a root grant (ADR-032 §5: a build tree is never read at
# runtime).
PING_CLIENT=/usr/lib/katmate/ping-client

# --- the journal ---------------------------------------------------------------
# katmate-lib.sh's three diagnostics, the same text and the same exit codes,
# each also written to the journal. Redefined here rather than wrapped, so the
# library's own readers (km_t1_read, km_check_instance) log their refusals too.
jlog() {
    logger -t katmate-launch -- "$*" \
        || printf '[%s] WARNING: logger failed; the line above is not in the journal\n' "$KM_PROG" >&2
}
km_log()   { printf '[%s] %s\n' "$KM_PROG" "$*"; jlog "$*"; }
km_die()   { printf '[%s] FATAL: %s\n' "$KM_PROG" "$*" >&2; jlog "FATAL: $*"; exit 1; }
km_usage() { printf '[%s] USAGE: %s\n' "$KM_PROG" "$*" >&2; jlog "USAGE: $*"; exit 2; }

USAGE="katmate-launch <instance> <app> | --stop <instance> | --stop-all | --cid-check"

# --- the instance set and the link -------------------------------------------
# The instance set is the T1 tree: an AppVM is admitted when its T1 file reads
# as class = app and the tree's CIDs are unique (#58). What it may run is the
# RUN line of its layer's T2 meta (ADR-043 §5); vm-agent checks the same list
# from the layer's /etc/katmate/run-whitelist.
#
# A routed AppVM's slot is claimed per run from its netVM's pool, with an
# opaque LINK_ID, by katmate-alloc (ADR-035 §5–6; ADR-037 R62, R63). netVM's
# slot MAC and the guest address come from katmate-generate-env --faces, the
# one place that layout is computed; after every start this script compares
# them with the projection's KM_GUEST_ADDR and KM_SLOT and refuses on a
# difference. Both helpers are T4 beside this script, never a build tree
# (R155).
ALLOC=/usr/lib/katmate/katmate-alloc
GENERATE_ENV=/usr/lib/katmate/katmate-generate-env
NETCFG_METRIC=100

PING_TIMEOUT=30   # seconds; PING answers ~4.5 s after start (ai5: try 3 of 2 s)
STOP_TIMEOUT=30   # seconds from SHUTDOWN to the unit leaving `active`
LOCK_TIMEOUT=90   # longer than one start or one stop

in_list() {
    local needle="$1" item
    shift
    for item in "$@"; do [[ "$item" == "$needle" ]] && return 0; done
    return 1
}

oneline() { local s="${1//$'\n'/ | }"; printf '%s' "${s%' | '}"; }

unit_state() { systemctl is-active "$1" 2>/dev/null || true; }

show_journal() {
    printf '[%s] last journal lines of %s:\n' "$KM_PROG" "$1" >&2
    journalctl -u "$1" -n 20 --no-pager -o short-precise >&2 || true
}

strip_fatal() { local s="${1//\[katmate-alloc\] FATAL: /}"; oneline "${s//\[katmate-generate-env\] FATAL: /}"; }

# --- the instance --------------------------------------------------------------
# t1_instances: the name of every T1 file, sorted.
t1_instances() {
    local f
    for f in "$KM_ETC_VM"/*.toml; do
        [[ -e "$f" ]] || continue
        f="${f##*/}"
        printf '%s\n' "${f%.toml}"
    done
}

# cid_pairs: "<instance> <cid>" for every T1 file, read with km_t1_read (R150).
# Run in $(…): every failure exits explicitly.
cid_pairs() {
    local inst cid
    while read -r inst; do
        km_t1_read "$inst"
        cid="$(km_t1_require cid)" || exit 1
        printf '%s %s\n' "$inst" "$cid"
    done < <(t1_instances)
}

# check_cids: a CID is unique across all T1 files and the reserved rows of
# docs/PARAMETERS.md (#58); katmate-alloc decides, T1 is read here.
check_cids() {
    local pairs out
    pairs="$(cid_pairs)" \
        || km_die "the T1 tree $KM_ETC_VM could not be read for the CID check (line above)"
    out="$("$ALLOC" cid check <<<"$pairs" 2>&1)" \
        || km_die "the CID check over $KM_ETC_VM refused: $(strip_fatal "$out")"
    [[ -z "$out" ]] || km_log "$(oneline "$out")"
    km_log "CID check: $(wc -l <<<"$pairs") T1 files, every CID unique"
}

# read_instance <instance>: T1 through katmate-lib.sh's reader, never a parser
# of its own (R150). Sets CID, NETVM, MANIFEST, UNIT and, for a routed
# instance, NETVM_CID; SLOT, LINK_ID, SLOT_MAC and PEER start empty.
read_instance() {
    local inst="$1" class nclass
    km_t1_read "$inst"
    class="$(km_t1_require class)"
    [[ "$class" == app ]] \
        || km_die "$KM_T1_FILE: class='$class'; katmate-launch starts AppVMs only (class = app)"
    MANIFEST="$(km_t1_require manifest)"
    CID="$(km_t1_require cid)"
    [[ "$CID" =~ ^[0-9]+$ ]] \
        || km_die "$KM_T1_FILE: cid='$CID' is not a fixed integer; a disposable's \"auto\" is ADR-017's, which katmate-launch does not run"
    NETVM="$(km_t1_require netvm)"
    SLOT="" LINK_ID="" SLOT_MAC="" PEER=""

    # The unit is SELECTED here and VERIFIED by katmate-generate-env, which is
    # the profile's one authority (ADR-032 §2, §6; R154). The unit name asserts
    # a profile, the generator derives one from (class, netvm, nic), and a
    # mismatch fails in its ExecStartPre=, before QEMU. This is the selection
    # ADR-032 §6 was written for, not a second derivation: nothing here decides
    # what a profile contains.
    if [[ -n "$NETVM" ]]; then
        UNIT="katmate-app-routed@$inst.service"
        # netVM's CID from its own T1 file, through the same reader.
        km_t1_read "$NETVM"
        nclass="$(km_t1_require class)"
        [[ "$nclass" == sys ]] \
            || km_die "$KM_T1_FILE: class='$nclass'; netVM '$NETVM' of $inst must be class = sys"
        NETVM_CID="$(km_t1_require cid)"
        [[ "$NETVM_CID" =~ ^[0-9]+$ ]] \
            || km_die "$KM_T1_FILE: cid='$NETVM_CID' is not an integer"
    else
        UNIT="katmate-app-offline@$inst.service"
    fi
}

routed() { [[ -n "$NETVM" ]]; }

owner_path() { printf '%s/link/%s/%s/owner' "$KM_RUN_DIR" "$NETVM" "$SLOT"; }

# --- the link: slot, faces, NETCFG -------------------------------------------
# claim_slot <instance>: sets SLOT and LINK_ID. katmate-alloc takes the lowest
# slot that is free or stale under the pool's lock; an owner this instance
# already holds (a crash, a --stop that never ran) is kept. A stale owner, one
# whose unit is not running, has its link withdrawn in netVM first and is then
# reclaimed, so its LINK_ID cannot outlive it there.
claim_slot() {
    local inst="$1" out state slot id who try
    for (( try = 1; try <= 16; try++ )); do
        out="$("$ALLOC" slot claim "$NETVM" "$inst" 2>&1)" \
            || km_die "no slot for $inst in netVM '$NETVM': $(strip_fatal "$out")"
        read -r state slot id who <<<"$out"
        case "$state" in
        claimed|kept)
            SLOT="$slot" LINK_ID="$id"
            km_log "slot $SLOT of $NETVM $state for $inst, LINK_ID $LINK_ID: $(owner_path)"
            return 0
            ;;
        stale)
            km_log "slot $slot of $NETVM holds a stale owner: $who, LINK_ID $id, whose unit is not running"
            netcfg_remove "$id" \
                || km_die "NETCFG REMOVE $id for $who, the stale owner of slot $slot, failed; the slot is not reclaimed"
            out="$("$ALLOC" slot reclaim "$NETVM" "$slot" "$who" "$id" 2>&1)" \
                || km_die "slot $slot was not reclaimed from $who: $(strip_fatal "$out")"
            km_log "slot $slot reclaimed from $who"
            ;;
        *)
            km_die "katmate-alloc slot claim answered '$(oneline "$out")'"
            ;;
        esac
    done
    km_die "no slot for $inst after 16 stale reclaims in netVM '$NETVM'"
}

# find_slot <instance>: SLOT and LINK_ID of the owner naming the instance, or
# both empty.
find_slot() {
    local inst="$1" out
    out="$("$ALLOC" slot find "$NETVM" "$inst" 2>&1)" \
        || km_die "cannot read the slot pool of netVM '$NETVM': $(strip_fatal "$out")"
    read -r SLOT LINK_ID <<<"$out" || true
}

# slot_faces: SLOT_MAC and PEER for SLOT, from the generator (R156: no
# arithmetic here). Returns 1, after a log line, so the caller can withdraw
# the claim first.
slot_faces() {
    local out k v
    if ! out="$("$GENERATE_ENV" --faces "$NETVM" "$SLOT" 2>&1)"; then
        km_log "katmate-generate-env --faces $NETVM $SLOT failed: $(strip_fatal "$out")"
        return 1
    fi
    while IFS='=' read -r k v; do
        case "$k" in
        KM_SLOT_MAC)   SLOT_MAC="$v" ;;
        KM_GUEST_ADDR) PEER="$v" ;;
        esac
    done <<<"$out"
    [[ -n "$SLOT_MAC" && -n "$PEER" ]] && return 0
    km_log "katmate-generate-env --faces $NETVM $SLOT answered '$(oneline "$out")'"
    return 1
}

netcfg_remove() {
    local id="$1" out
    if out="$("$PING_CLIENT" netcfg-remove "$NETVM_CID" "$id" 2>&1)"; then
        km_log "NETCFG REMOVE $id to CID $NETVM_CID: OK"
        return 0
    fi
    km_log "NETCFG REMOVE $id to CID $NETVM_CID failed: $(oneline "$out")"
    return 1
}

netcfg_add() {
    local out
    if out="$("$PING_CLIENT" netcfg-add "$NETVM_CID" "$LINK_ID" "$SLOT_MAC" "$PEER" "$NETCFG_METRIC" 2>&1)"; then
        km_log "NETCFG ADD $LINK_ID $SLOT_MAC $PEER metric $NETCFG_METRIC to CID $NETVM_CID: OK"
        return 0
    fi
    km_log "NETCFG ADD $LINK_ID to CID $NETVM_CID failed: $(oneline "$out")"
    return 1
}

# withdraw_link <instance>: NETCFG REMOVE and the owner, for the slot in SLOT
# and LINK_ID. REMOVE of an unknown id is OK at the agent, so it is idempotent;
# katmate-alloc releases only an owner naming this instance with this LINK_ID.
# Returns 1 if anything could not be withdrawn, after trying both.
withdraw_link() {
    local inst="$1" ns out rc=0
    if [[ -z "$LINK_ID" ]]; then
        km_log "$inst holds no slot of netVM '$NETVM'; nothing to withdraw"
        return 0
    fi
    ns="$(unit_state "katmate-sys-driver@$NETVM.service")"
    if [[ "$ns" == active ]]; then
        netcfg_remove "$LINK_ID" || rc=1
    else
        km_log "netVM '$NETVM' is '$ns': NETCFG REMOVE $LINK_ID skipped (a netVM that is not running holds no link)"
    fi

    if out="$("$ALLOC" slot release "$NETVM" "$inst" "$LINK_ID" 2>&1)"; then
        case "$out" in
        removed*) km_log "owner removed: $(owner_path)" ;;
        *)        km_log "no owner names $inst in netVM '$NETVM'; nothing to remove" ;;
        esac
    else
        km_log "owner of slot $SLOT not released: $(strip_fatal "$out")"
        rc=1
    fi
    return "$rc"
}

# --- start, PING, RUN ----------------------------------------------------------
# The generator's projection is complete when `systemctl start` returns: its
# ExecStartPre= chain has run by then (Type=simple returns once QEMU forks).
readback() {
    local inst="$1" env got_addr got_slot
    env="$KM_RUN_DIR/vm/$inst.env"
    got_addr="" got_slot=""
    if [[ -f "$env" ]]; then
        got_addr="$(km_meta_get "$env" KM_GUEST_ADDR)"
        got_slot="$(km_meta_get "$env" KM_SLOT)"
    fi
    if [[ "$got_addr" == "$PEER" && "$got_slot" == "$SLOT" ]]; then
        km_log "read-back: $env has KM_GUEST_ADDR=$got_addr KM_SLOT=$got_slot, as claimed"
        return 0
    fi
    km_log "read-back MISMATCH: $env has KM_GUEST_ADDR='$got_addr' KM_SLOT='$got_slot'; claimed was $PEER, slot $SLOT. Stopping $UNIT."
    systemctl stop "$UNIT" || km_log "systemctl stop $UNIT failed"
    withdraw_link "$inst" || true
    km_die "the generator placed $inst at '$got_addr' (slot '$got_slot'), and NETCFG was issued for $PEER (slot $SLOT). $UNIT is stopped and the link withdrawn (R156)."
}

cold_start() {
    local inst="$1" ns
    if routed; then
        ns="$(unit_state "katmate-sys-driver@$NETVM.service")"
        [[ "$ns" == active ]] \
            || km_die "netVM '$NETVM' is '$ns', not active. katmate-launch does not start netVM in the alpha (R150): start katmate-sys-driver@$NETVM.service first."
        claim_slot "$inst"
        if ! slot_faces; then
            withdraw_link "$inst" || true
            km_die "no slot faces for $inst on slot $SLOT; the owner is withdrawn and $UNIT was not started"
        fi
        if ! netcfg_add; then
            withdraw_link "$inst" || true
            km_die "NETCFG ADD for $inst failed; the owner is withdrawn and $UNIT was not started"
        fi
    fi

    km_log "systemctl start $UNIT"
    if ! systemctl start "$UNIT"; then
        show_journal "$UNIT"
        if routed; then withdraw_link "$inst" || true; fi
        km_die "systemctl start $UNIT failed (journal lines above, and journalctl -u $UNIT)"
    fi
    if routed; then readback "$inst"; fi
}

wait_ping() {
    local inst="$1" out="" try=0 t0 now
    t0="$(date +%s%3N)"
    while :; do
        try=$(( try + 1 ))
        if out="$("$PING_CLIENT" ping "$CID" 2>&1)"; then
            now="$(date +%s%3N)"
            km_log "PING CID $CID ($inst): OK on try $try, $(( now - t0 )) ms"
            return 0
        fi
        now="$(date +%s%3N)"
        (( now - t0 < PING_TIMEOUT * 1000 )) || break
        sleep 1
    done
    show_journal "$UNIT"
    km_die "no PING answer from CID $CID ($inst) in ${PING_TIMEOUT} s, $try tries; last: $(oneline "$out"). $UNIT is left as it is; 'katmate-launch --stop $inst' stops it."
}

# check_run <instance> <app>: the host is the authority (ADR-043 §5). A RUN the
# layer's list lacks is refused here, before any unit is started.
check_run() {
    local inst="$1" app="$2" meta run
    local -a words=()
    [[ "$MANIFEST" =~ $KM_LAYER_NAME_RE ]] \
        || km_die "$KM_ETC_VM/$inst.toml: manifest='$MANIFEST' does not match $KM_LAYER_NAME_RE"
    meta="$KM_STATE_DIR/app-$MANIFEST.meta"
    km_meta_open "$meta"
    run="$(km_meta_require "$meta" RUN)"
    read -r -a words <<<"$run"
    in_list "$app" "${words[@]}" \
        || km_die "app '$app' is not in the RUN list of layer '$MANIFEST' that $inst runs on ($meta: RUN=$run)"
}

run_app() {
    local inst="$1" app="$2" out
    if out="$("$PING_CLIENT" run "$CID" "$app" 2>&1)"; then
        km_log "RUN $app in $inst (CID $CID): OK"
        return 0
    fi
    km_die "RUN $app in $inst (CID $CID) failed: $(oneline "$out")"
}

launch() {
    local inst="$1" app="$2" st
    km_check_instance "$inst"
    [[ "$app" =~ $KM_PKG_NAME_RE ]] \
        || km_die "app '$app' does not match $KM_PKG_NAME_RE"
    read_instance "$inst"
    check_run "$inst" "$app"
    check_cids

    km_log "launch $inst $app (unit $UNIT, CID $CID, invoked by ${SUDO_USER:-<no SUDO_USER>})"
    st="$(unit_state "$UNIT")"
    case "$st" in
    active)          km_log "$UNIT is active: no start, RUN only" ;;
    inactive|failed) cold_start "$inst" ;;
    *)               km_die "$UNIT is '$st'; refusing to act on a unit in transition. Try again." ;;
    esac
    wait_ping "$inst"
    run_app "$inst" "$app"
}

# --- stop ----------------------------------------------------------------------
stop_instance() {
    local inst="$1" st out deadline
    km_check_instance "$inst"
    read_instance "$inst"
    if routed; then find_slot "$inst"; fi
    km_log "stop $inst (unit $UNIT, CID $CID, invoked by ${SUDO_USER:-<no SUDO_USER>})"
    st="$(unit_state "$UNIT")"
    if [[ "$st" == active ]]; then
        if out="$("$PING_CLIENT" shutdown "$CID" 2>&1)"; then
            km_log "SHUTDOWN CID $CID ($inst): OK"
            deadline=$(( $(date +%s) + STOP_TIMEOUT ))
            while [[ "$(unit_state "$UNIT")" == active ]] && (( $(date +%s) < deadline )); do
                sleep 1
            done
        else
            km_log "SHUTDOWN CID $CID ($inst) failed: $(oneline "$out")"
        fi
        st="$(unit_state "$UNIT")"
        if [[ "$st" == active ]]; then
            # The agent did not answer, or the guest did not power off in
            # time. systemd owns the process (ADR-029), so it is asked.
            km_log "$UNIT still active after SHUTDOWN; systemctl stop $UNIT"
            systemctl stop "$UNIT" || km_die "systemctl stop $UNIT failed"
            st="$(unit_state "$UNIT")"
        fi
        km_log "$UNIT is now '$st'"
    else
        km_log "$UNIT is '$st': nothing to shut down"
    fi
    if routed; then
        withdraw_link "$inst" || km_die "the link of $inst was not fully withdrawn (lines above)"
    fi
}

# --stop-all: every AppVM in T1 whose unit is active, or which still holds an
# owner (a routed instance that crashed). One failure does not stop the others;
# the exit is 1 if any failed.
stop_all() {
    local inst st fails=0
    km_log "stop-all (invoked by ${SUDO_USER:-<no SUDO_USER>})"
    while read -r inst <&3; do
        (
            km_t1_read "$inst"
            [[ "${KM_T1[class]}" == app ]] || exit 0
            read_instance "$inst"
            if routed; then find_slot "$inst"; fi
            st="$(unit_state "$UNIT")"
            if [[ "$st" != active && -z "$LINK_ID" ]]; then
                km_log "stop-all: $inst is '$st' and holds no link; skipped"
                exit 0
            fi
            stop_instance "$inst"
        ) || fails=$(( fails + 1 ))
    done 3< <(t1_instances)
    (( fails == 0 )) || km_die "stop-all: $fails instance(s) failed to stop cleanly (lines above)"
    km_log "stop-all: done"
}

# --- main ----------------------------------------------------------------------
# One launcher at a time: two clicks on one instance must not both claim its
# slot. The lock lives in /run/katmate, the only tree a T4 executable writes.
LOCK_DIR="$(km_run_subdir launch 0700)"
exec 9>"$LOCK_DIR/lock"
flock -w "$LOCK_TIMEOUT" 9 \
    || km_die "another katmate-launch has held $LOCK_DIR/lock for ${LOCK_TIMEOUT} s"

case "${1-}" in
--stop)
    (( $# == 2 )) || km_usage "$USAGE"
    stop_instance "$2"
    ;;
--stop-all)
    (( $# == 1 )) || km_usage "$USAGE"
    stop_all
    ;;
--cid-check)
    (( $# == 1 )) || km_usage "$USAGE"
    check_cids
    ;;
-*|"")
    km_usage "$USAGE"
    ;;
*)
    (( $# == 2 )) || km_usage "$USAGE"
    launch "$1" "$2"
    ;;
esac
