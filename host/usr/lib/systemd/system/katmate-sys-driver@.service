[Unit]
# T3+T4 (ADR-030 §2): the unit template IS the serialisation of the class profile
# and the TCB constants. There is no profile file beside it, and the profile is
# carried in the unit NAME — katmate-sys-driver@netvm.service — not in a field,
# so `systemctl status` displays it without a query to anything.
#
# sys-driver = f(class = sys, nic = Some): a q35 machine holding a physical NIC.
# The user declares topology in T1 and the profile follows, which is the only
# reason T3 may be derived from T1 without T1 becoming an attack surface: a user
# cannot select weaker containment.
#
# Transcribed from ~/net-sys.con, which was the de facto specification. Four
# changes, each required by a decision already taken; they are marked (1)-(4)
# below where they occur.
Description=KatMate sysVM (driver domain): %i
# No Documentation= : no man page ships. See the comment in
# katmate-publish-nics.service.

# The nic label for this boot must exist before the projection can resolve it.
Requires=katmate-publish-nics.service
After=katmate-publish-nics.service

# NOT network-online.target, and this is not an omission. On this host it never
# fires: every networkd-managed link is a carrier-less tap and both routable
# links are unmanaged, so networkctl reports "State: routable" beside
# "Online state: offline" (measured 2026-08-02, HOST-CONFIG.md §1). A VM unit
# waiting for it would wait forever, with no diagnostic. This VM does not need
# the host to be online in any case — it is the thing that MAKES the host's
# guests online, and it holds the card itself.
After=local-fs.target

[Service]
Type=simple

# --- the ExecStartPre= chain, cheapest gate first ----------------------------
# One executable per check, never one binary taking a mode argument: systemd
# stops at the first failing ExecStartPre= and the journal names the line that
# failed, and that naming is the whole reason for the shape (ADR-032 §2).
#
# Order is by cost, so a mismatch fails before any device is activated:
#
#  1. katmate-check-image   — plain file reads, unprivileged. Kernel, initrd and
#                             <image>.meta. It does NOT check the rootfs LV: LVM
#                             metadata is unreadable below uid 0 (measured — `lvs`
#                             exits 5 as uid 1000), so LV existence moved to the
#                             step that already has uid 0. ADR-032 §2 revision
#                             note, 2026-08-11.
#  2. katmate-activate-lvs  — `+`, uid 0. lvchange -K -ay, and with it the LV
#                             existence check. An RO-frozen thin LV keeps the
#                             skip-activation flag permanently, so this runs on
#                             EVERY boot, not only the first.
#  3. katmate-generate-env  — `+`, uid 0 (ADR-030 §8). Projects T2, T1 and the
#                             start-time scalars into the file EnvironmentFile=
#                             reads below, resolves the nic label against /sys,
#                             and refuses if the profile it derives from
#                             (class, netvm, nic) is not the one this unit's name
#                             asserts (ADR-032 §6).
#
# The `+` on the generator is not optional: the projection is root-owned so that
# the uid QEMU runs as cannot rewrite the environment it is about to be started
# with.
#
# katmate-check-waypipe is deliberately absent: a sysVM runs no waypipe. It
# belongs to the two AppVM profiles.
ExecStartPre=/usr/lib/katmate/katmate-check-image %i
ExecStartPre=+/usr/lib/katmate/katmate-activate-lvs %i
ExecStartPre=+/usr/lib/katmate/katmate-generate-env %p %i

# E1, measured 2026-08-06 on MINIS: EnvironmentFile= IS read late enough to see a
# file created by ExecStartPre= in the same unit. Candidate A — one unit per VM,
# no second unit class, and the projection is produced and consumed inside one
# unit's lifetime, so a half-started VM cannot leave a live env file for the next
# start to inherit.
EnvironmentFile=/run/katmate/vm/%i.env

# --- the VMM ------------------------------------------------------------------
# Every value that crosses is a scalar interpolated at a FIXED position, in the
# braced form: ${} does not word-split, so a value cannot become additional
# arguments (ADR-030 §3). There is no argv blob and no per-instance drop-in —
# whoever could write either would be able to add a second -drive onto a foreign
# LV, or a later -sandbox overriding this one.
#
# (1) -nographic and -serial mon:stdio are OUT (ADR-030 §6, ADR-032 §6).
#     -nographic alone multiplexes the serial console AND the monitor onto one
#     stream; under a unit there is no stdio terminal, and StandardInput= would
#     hand the monitor to whoever can write to it. The shipped form is
#     -display none -monitor none plus an explicit serial chardev.
# (2) -nodefaults -no-user-config are IN. net-sys.con had neither, which left
#     less containment in the most exposed VM than in an AppVM: -vga none covers
#     graphics only, and the default configuration file was still read. With
#     -nodefaults a q35 machine builds NOTHING implicitly, so every device below
#     is listed deliberately. Gate G4.
# (3) The kernel and initrd come from /var/lib/katmate/netvm/ via T2, never from
#     out/. A unit reading a build tree would be a release running from build
#     artefacts (ADR-032 §5).
# (4) The BDF is resolved from the nic label at start (${KM_VFIO_BDF}), never
#     written into this template. A BDF is assigned by firmware enumeration and
#     moves; the failure mode of a stale one is some OTHER device handed to this
#     VM, silently (ADR-030 §5).
#
# Carried UNCHANGED and deliberately not decided here (brief §7): the
# memory-backend-memfd/hugepages division between this VM and app_web, and
# -overcommit mem-lock=off, which is probably inert since vfio pins the entire
# guest RAM regardless. Both belong to the memory session.
ExecStart=/usr/bin/qemu-system-x86_64 \
    -enable-kvm \
    -nodefaults \
    -no-user-config \
    -object memory-backend-memfd,id=mem,size=${KM_MEM},share=on \
    -machine q35,accel=kvm,memory-backend=mem \
    -cpu host,topoext=on \
    -overcommit mem-lock=off \
    -smp ${KM_VCPUS} \
    -display none \
    -vga none \
    -monitor none \
    -chardev stdio,id=console0,signal=off \
    -serial chardev:console0 \
    -object iothread,id=iothread0 \
    -device virtio-rng-pci \
    -device vhost-vsock-pci,guest-cid=${KM_CID} \
    -kernel ${KM_KERNEL} \
    -initrd ${KM_INITRD} \
    -append "root=${KM_ROOT_DEVICE} rw console=ttyS0" \
    -drive file=${KM_ROOTFS_DEV},if=none,id=disk0,format=raw,cache=none,aio=threads,discard=ignore,detect-zeroes=off \
    -device virtio-blk-pci,drive=disk0,iothread=iothread0 \
    -device vfio-pci,host=${KM_VFIO_BDF} \
    -netdev tap,id=int0,ifname=tap-int0,script=no,downscript=no \
    -device virtio-net-pci,netdev=int0,mac=${KM_MAC_INT} \
    -sandbox on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny

# The serial console goes to the journal, one way. That is the correct end state
# — open problem #12 becomes unreachable rather than resolved — and it means
# in-guest observation during bring-up needs a pty or a separate dev launcher,
# which must NOT be this unit. A development monitor is a drop-in at
# /etc/systemd/system/katmate-sys-driver@.service.d/90-dev-monitor.conf:
# additive, per-machine, out of git, and on the list of dev scaffolding to be
# removed before release (ADR-030 §6).
StandardInput=null
StandardOutput=journal
StandardError=journal

# vfio pins the ENTIRE guest RAM for DMA regardless of -overcommit mem-lock=off
# or hugepages, so an inherited RLIMIT_MEMLOCK of 8192 KB makes QEMU die at
# VFIO_MAP_DMA with "cannot allocate memory" — not a real OOM. Until this unit
# existed, `ulimit -l unlimited` before a manual launch was not a workaround but
# the only mechanism; this directive is what replaces it (C3).
LimitMEMLOCK=infinity

# Shutdown is deliberately NOT a QMP power button: no control socket exists, and
# graceful stop is netvm-agent's SHUTDOWN opcode, which signals PID 1 with
# SIGRTMIN+4 under CAP_KILL (ADR-024). Ordering that is the launch daemon's job
# in step 3b — including refusing to tear down a provides_network VM with live
# dependents. Until then a stop here is SIGTERM to QEMU, which ends the VM
# without a clean guest shutdown, and TimeoutStopSec bounds it.
KillMode=control-group
TimeoutStopSec=30s
Restart=no

[Install]
# Deliberately no WantedBy=: nothing starts a VM at boot yet. Enablement is the
# launch daemon's decision in step 3b, and until then a VM is started explicitly
# by `systemctl start katmate-sys-driver@<instance>`.
