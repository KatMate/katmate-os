# Gap #10 CLOSED 2026-07-28: no 9p hostshare into netVM.
# Was: -fsdev local,path=/home/host,security_model=none + virtio-9p-pci
# The whole host home in the most network-exposed VM, unmapped uids.
# If a dev file path is ever needed again, it must be a narrow subtree
# with security_model=mapped-xattr, and it must be a separate dev launcher.

qemu-system-x86_64 \
	-enable-kvm \
	-object memory-backend-memfd,id=mem,size=1G,share=on \
	-machine q35,accel=kvm,memory-backend=mem \
	-cpu host,topoext=on \
	-overcommit mem-lock=off \
	-smp 1 \
	-display none -vga none \
	-nographic \
	-serial mon:stdio \
	-object iothread,id=iothread0 \
	-device virtio-rng-pci \
	-device vhost-vsock-pci,guest-cid=3 \
	-kernel /home/host/katmate-build/out/netvm/vmlinuz \
	-initrd /home/host/katmate-build/out/netvm/initrd.img \
	-append "root=/dev/vda rw console=ttyS0" \
	-drive file=/dev/vg0/vm_sys_netvm,if=none,id=disk0,format=raw,cache=none,aio=threads,discard=ignore,detect-zeroes=off \
	-device virtio-blk-pci,drive=disk0,iothread=iothread0 \
	-device vfio-pci,host=0000:01:00.0 \
	-netdev tap,id=int0,ifname=tap-int0,script=no,downscript=no \
	-device virtio-net-pci,netdev=int0,mac=52:54:0a:64:01:01 \
	-sandbox on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny
