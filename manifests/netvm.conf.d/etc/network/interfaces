# netVM /etc/network/interfaces — lo + source only.
# The stale enx00e04c3961b8 static block (host USB-NIC MAC, a netinst artefact)
# is deliberately absent and must never be re-baked. The uplink belongs to
# dhcpcd (/etc/dhcpcd.conf, ADR-037 R6); the slots km00..km0f belong to
# netvm-agent's NETCFG (ADR-025 Path B). Nothing here configures either.
auto lo
iface lo inet loopback

source /etc/network/interfaces.d/*
