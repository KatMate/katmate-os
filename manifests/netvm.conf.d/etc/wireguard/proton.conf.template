# netVM ProtonVPN/WireGuard config TEMPLATE (ADR-021).
#
# This TEMPLATE is baked into the image. It is NOT a secret. The real
# /etc/wireguard/proton.conf, with concrete keys, is written at PROVISIONING
# time and is never part of the image (image/state separation). A rebuild of
# the netVM image therefore never destroys installed credentials.
#
# Provisioning substitutes the __PLACEHOLDER__ values and writes proton.conf.
[Interface]
PrivateKey = __WG_PRIVATE_KEY__
Address = 10.2.0.2/32
# DNS here interacts with the DNS-leak policy decision in 20-uplink.network
# (ADR-021 open decision). If policy (a) is chosen, this pushes the VPN
# resolver; keep consistent with the uplink UseDNS setting.
DNS = 10.2.0.1

[Peer]
PublicKey = __WG_PEER_PUBLIC_KEY__
Endpoint = __WG_ENDPOINT__
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
