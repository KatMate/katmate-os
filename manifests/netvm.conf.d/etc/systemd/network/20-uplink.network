# netVM uplink — MAC-matched DHCP on the passed-through vfio NIC (ADR-021).
# This is the ONLY network unit baked into the image. All internal /32 p2p
# routes (personalVM and every appVM) are delivered at launch via the agent's
# NETCFG; the image is appVM-agnostic and bakes no internal topology.
[Match]
MACAddress=38:05:25:34:7c:47

[Network]
DHCP=ipv4

[DHCP]
RouteMetric=100
# DNS-LEAK POLICY — OPEN DECISION (ADR-021). The LAN DHCP lease supplies a DNS
# server, which would leak queries outside the ProtonVPN tunnel. Before release,
# decide and set ONE of:
#   (a) UseDNS=false here, and push DNS=10.2.0.1 + Domains=~. via the proton
#       tunnel config, so all resolution goes through the VPN; or
#   (b) drop uplink DNS entirely.
# Left unset on purpose — do not silently bake a leak.
